# Copy this file to .env and fill in the values. .env is never uploaded to GitHub.

# From https://serpapi.com/manage-api-key. Leave empty to use demo prices.
SERPAPI_KEY=

# From Neon (starts with postgresql://). Leave empty to save prices in flights.db.
DATABASE_URL=

# Any long random text; the same value goes in GitHub's CRON_SECRET secret.
CRON_SECRET=
